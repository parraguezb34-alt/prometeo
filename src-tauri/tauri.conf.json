{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prometeo",
  "version": "1.0.0",
  "identifier": "dev.lienzo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Prometeo",
        "width": 1360,
        "height": 860,
        "minWidth": 800,
        "minHeight": 520,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Prometeo",
    "shortDescription": "Centro de mando para dirigir un equipo de agentes de IA",
    "longDescription": "Prometeo reúne en una sola ventana a los agentes de IA de tu máquina (Claude Code, OpenCode, Codex y Antigravity) para que trabajen en equipo sin pisarse.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
